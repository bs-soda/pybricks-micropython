{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soda.dev/schemas/context-bundle.schema.json",
  "title": "Soda execution bundle (compiled)",
  "description": "Output of Context Compiler. See docs/03-architecture/context-compiler.md",
  "type": "object",
  "required": ["version", "goal_id", "generated_at"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "goal_id": { "type": "string", "pattern": "^(G-[A-Z]{2,8}-[0-9]{3}|G-[0-9]{3})$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_hash": {
      "type": "string",
      "description": "hash(goal + manifest + linked decision ids) for cache lookup"
    },
    "cache_id": {
      "type": "string",
      "pattern": "^(G-[A-Z]{2,8}-[0-9]{3}|G-[0-9]{3})-[a-f0-9]{6}$",
      "description": "e.g. G-PAY-001-a82f1c or legacy G-001-a82f1c"
    },
    "compile": {
      "type": "object",
      "properties": {
        "step": { "type": ["integer", "null"], "minimum": 1 },
        "role": {
          "type": "string",
          "enum": ["developer", "backend", "frontend", "qa", "designer", "product", "devops"]
        },
        "agent": { "type": "string" },
        "mode": { "type": "string", "enum": ["execute", "review", "discover", "plan"] }
      }
    },
    "manifest": {
      "type": "object",
      "properties": {
        "adr": { "type": "array", "items": { "type": "string" } },
        "pdr": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E-\\d{3}$" } },
        "pains": { "type": "array", "items": { "type": "string", "pattern": "^P-\\d{3}$" } },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "action": {
      "type": "object",
      "description": "Action bundle for current step — see action-bundle.example.yaml",
      "required": ["current_step", "objective", "exit_when"],
      "properties": {
        "current_step": { "type": "integer", "minimum": 1 },
        "role": { "type": "string" },
        "mode": { "type": "string" },
        "objective": { "type": "string" },
        "allowed_files": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "expected_output": { "type": "array", "items": { "type": "string" } },
        "exit_when": { "type": "array", "items": { "type": "string" } },
        "next_step": { "type": ["integer", "null"] },
        "context_refs": { "type": "object" },
        "skills": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object",
      "description": "Recipe + profile — reduces cognitive load",
      "properties": {
        "execution_mode": { "type": "string" },
        "task_type": { "type": "string" },
        "profile": { "type": "string" },
        "recipe": { "type": "string", "pattern": "^REC-\\d{3}$" },
        "checklist": { "type": "array", "items": { "type": "string" } },
        "completion": { "type": "array", "items": { "type": "string" } },
        "agent_capability": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "progressive_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "step_md", "action_yaml"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "step_md": { "type": "string" },
          "action_yaml": { "type": "string" }
        }
      }
    },
    "score": {
      "type": "object",
      "properties": {
        "estimated_tokens": { "type": "integer" },
        "files": { "type": "integer" },
        "confidence_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "redundant_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_tokens": { "type": "integer", "default": 2500 },
        "trimmed": { "type": "boolean", "default": false },
        "trimmed_sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "goal_hash": { "type": "string" },
        "file_hashes": { "type": "object", "additionalProperties": { "type": "string" } },
        "observation_count": { "type": "integer" },
        "bundle_at": { "type": "string", "format": "date-time" }
      }
    },
    "delta": {
      "type": "object",
      "properties": {
        "unchanged": { "type": "array", "items": { "type": "string" } },
        "changed": { "type": "array", "items": { "type": "string" } },
        "new": { "type": "array", "items": { "type": "string" } },
        "read_paths": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
